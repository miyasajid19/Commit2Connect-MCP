# ============================================================================
# commit2connect-mcp — environment template
# ============================================================================
# Copy to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real secrets.
# Generate SECRET_KEY with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================================


# ----------------------------------------------------------------------------
# LinkedIn OAuth
# ----------------------------------------------------------------------------
# Create an app at https://www.linkedin.com/developers/apps and use the
# "Auth" tab's Client ID and Primary Client Secret.

LINKEDIN_CLIENT_ID=
LINKEDIN_PRIMARY_CLIENT_SECRET=

# OAuth redirect URI — must EXACTLY match a redirect URL registered in your
# LinkedIn app's Auth settings.
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/callback

# Permissions requested from the user.
#   openid + profile + email  -> OIDC identity (who you are)
#   w_member_social           -> post/comment/react as the authenticated member
#   r_member_social           -> read member social data
LINKEDIN_SCOPES=openid profile email w_member_social r_member_social


# ----------------------------------------------------------------------------
# LinkedIn posting
# ----------------------------------------------------------------------------
# Bearer token used by the LinkedIn posting tools. Run `python oauth.py` to
# mint one interactively, or paste a token from your LinkedIn app's tools.
LINKEDIN_ACCESS_TOKEN=

# LinkedIn REST API surface (do not change unless LinkedIn revs the product).
LINKEDIN_API_BASE=https://api.linkedin.com
LINKEDIN_API_VERSION=202609


# ----------------------------------------------------------------------------
# GitHub
# ----------------------------------------------------------------------------
# Personal access token with `repo` scope:
#   https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Default repository owner used when a tool call doesn't specify one.
GITHUB_OWNER=


# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
# Port the FastMCP server binds to (HTTP transport at /mcp).
PORT=8000

# Used to sign the OAuth `state` parameter (CSRF protection).
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=